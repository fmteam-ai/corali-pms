# Copy to runtime.env on cPanel. Never commit real secrets.
NODE_ENV=production
DATABASE_URL=postgresql://user:URL_ENCODED_PASSWORD@127.0.0.1:5432/corali_pms
DATABASE_SSL=false
DATABASE_SSL_CA=
SESSION_SECRET=generate_at_least_32_random_bytes
PMS_DOCUMENT_KEY=generate_32_random_bytes_base64
APP_ROLE=pms
PMS_ORIGIN=https://pms.hotelcorali.gr
BOOKING_ORIGIN=https://booking.hotelcorali.gr
PMS_OWNER_ID=hotel-corali
CRON_SECRET=generate_at_least_32_random_bytes
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BIRTHDAY_TEMPLATE_EN=
WHATSAPP_BIRTHDAY_TEMPLATE_EL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
MYDATA_PROVIDER_TOKEN=
CHANNEL_MANAGER_API_KEY=
OPENAI_API_KEY=
# Optional: AI assistant in the booking engine (or set the key in PMS → Integrations → Anthropic).
ANTHROPIC_API_KEY=
