# Set these as Fly.io secrets (fly secrets set NAME=value), never in fly.toml or in git.
MONITORING_SECRET=          # the same value as MONITORING_SECRET in the PMS runtime.env (at least 32 characters)
TELEGRAM_BOT_TOKEN=         # optional: a Telegram bot (BotFather) …
TELEGRAM_CHAT_ID=           # … and the chat that receives the alerts
NTFY_URL=                   # optional: e.g. https://ntfy.sh/<a-long-random-topic> (push to phones, free)
ALERT_WEBHOOK_URL=          # optional: any HTTPS endpoint that accepts JSON
DEADMAN_URL=                # optional: e.g. a healthchecks.io ping URL — alerts if the watchdog itself stops
