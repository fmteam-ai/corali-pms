function languagePicker(): string
{
    global $language;
    $el = $language === 'el' ? ' active' : '';
    $en = $language === 'en' ? ' active' : '';
    return '<nav class="languages" aria-label="' . htmlspecialchars(i18n('choose_language'), ENT_QUOTES, 'UTF-8') . '">'
        . '<a class="language' . $el . '" href="?lang=el" lang="el">Ελληνικά</a>'
        . '<a class="language' . $en . '" href="?lang=en" lang="en">English</a></nav>';
}

function bilingual(string $greek, string $english): string
{
    global $language;
    return $language === 'en' ? $english : $greek;
}

