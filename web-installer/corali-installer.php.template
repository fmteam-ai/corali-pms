        . '@font-face{font-family:CoraliUI;src:url(data:font/ttf;base64,' . CORALI_FONT_BOLD . ');font-weight:700}';
}

function failPage(int $status, string $title, string $message): never
{
    global $language;
    http_response_code($status);
    $safeTitle = htmlspecialchars($title, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $safeMessage = htmlspecialchars($message, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    echo "<!doctype html><html lang=\"" . htmlspecialchars($language, ENT_QUOTES, 'UTF-8') . "\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{$safeTitle}</title><style>" . fontCss() . "body{margin:0;background:#f5f2ec;color:#173f47;font:16px CoraliUI,Arial,sans-serif}.box{max-width:680px;margin:10vh auto;background:#fff;padding:34px;border-radius:22px;box-shadow:0 18px 55px #173f4720}h1{margin-top:0}.bad{color:#a33924}</style><main class=\"box\"><h1>{$safeTitle}</h1><p class=\"bad\">{$safeMessage}</p></main></html>";
    exit;
}

function accessPage(string $csrf, string $message = ''): never
{
    global $language;
    http_response_code($message === '' ? 200 : 403);
    $safeCsrf = htmlspecialchars($csrf, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $safeMessage = htmlspecialchars($message, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $notice = $safeMessage === '' ? '' : '<p class="bad">' . $safeMessage . '</p>';
    echo '<!doctype html><html lang="' . htmlspecialchars($language, ENT_QUOTES, 'UTF-8') . '"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
        . '<title>' . htmlspecialchars(i18n('installer'), ENT_QUOTES, 'UTF-8') . '</title><style>' . fontCss() . 'body{margin:0;background:#f5f2ec;color:#173f47;font:16px CoraliUI,Arial,sans-serif}'
        . '.box{max-width:680px;margin:10vh auto;background:#fff;padding:34px;border-radius:22px;box-shadow:0 18px 55px #173f4720}'
        . 'h1{margin-top:0}.bad{color:#a33924}label{display:block;font-weight:700;margin:22px 0 8px}input{box-sizing:border-box;width:100%;padding:13px;border:1px solid #a9bac0;border-radius:10px;font:inherit}'
        . 'button{margin-top:18px;border:0;border-radius:10px;background:#173f47;color:#fff;padding:13px 20px;font-weight:700;cursor:pointer}.languages{display:flex;gap:8px;margin:0 0 24px}.language{padding:8px 12px;border:1px solid #a9bac0;border-radius:999px;color:#173f47;text-decoration:none}.language.active{background:#173f47;color:#fff}</style>'
        . '<main class="box">' . languagePicker() . '<h1>' . htmlspecialchars(i18n('installer'), ENT_QUOTES, 'UTF-8') . '</h1><p>' . htmlspecialchars(i18n('access_intro'), ENT_QUOTES, 'UTF-8') . '</p>'
        . $notice . '<form method="post"><input type="hidden" name="access_csrf" value="' . $safeCsrf . '">'
        . '<input type="hidden" name="language" value="' . htmlspecialchars($language, ENT_QUOTES, 'UTF-8') . '"><input type="hidden" name="access_action" value="authorize"><label for="access_key">' . htmlspecialchars(i18n('access_code'), ENT_QUOTES, 'UTF-8') . '</label>'
        . '<input id="access_key" name="access_key" type="password" autocomplete="off" required autofocus>'
        . '<button type="submit">' . htmlspecialchars(i18n('open_installer'), ENT_QUOTES, 'UTF-8') . '</button></form></main></html>';
    exit;
}

function availableFunction(string $name): bool
{
    $disabled = array_filter(array_map('trim', explode(',', (string) ini_get('disable_functions'))));
    return function_exists($name) && !in_array($name, $disabled, true);
}

function commandPath(string $command): string
{
    if (!availableFunction('exec')) {
        return '';
    }
    $output = [];
    $status = 1;
    exec('command -v ' . escapeshellarg($command) . ' 2>/dev/null', $output, $status);
    return $status === 0 ? trim((string) ($output[0] ?? '')) : '';
}

function resolvedCommandPath(string $command): string
{
    $fromPath = commandPath($command);
    if ($fromPath !== '') {
        return $fromPath;
    }

    if ($command !== 'node') {
        return '';
    }

    // PHP-FPM on cPanel intentionally receives a minimal PATH. Probe only
    // trusted, administrator-managed Node.js locations instead of accepting
    // a path from the browser.
    $candidates = [
        '/opt/cpanel/ea-nodejs26/bin/node',
        '/opt/cpanel/ea-nodejs24/bin/node',
        '/opt/cpanel/ea-nodejs22/bin/node',
        '/opt/alt/alt-nodejs26/root/usr/bin/node',
        '/opt/alt/alt-nodejs24/root/usr/bin/node',
        '/opt/alt/alt-nodejs22/root/usr/bin/node',
    ];
    foreach ($candidates as $candidate) {
        if (is_file($candidate) && is_executable($candidate)) {
            return $candidate;
        }
    }
    return '';
}

function directoryCanBeUsed(string $directory): bool
{
    if (is_dir($directory)) {
        return is_writable($directory);
    }
    $parent = dirname($directory);
    return is_dir($parent) && is_writable($parent);
}

function deploymentDirectories(): array
{
    $apps = CORALI_HOME . '/apps';
    $preferredReleaseRoot = CORALI_HOME . '/releases';
    $preferredBackupRoot = CORALI_HOME . '/backups';
    $fallbackReleaseRoot = $apps . '/.corali-releases';
    $fallbackBackupRoot = $apps . '/.corali-backups';

    return [
        'release_root' => directoryCanBeUsed($preferredReleaseRoot) ? $preferredReleaseRoot : $fallbackReleaseRoot,
        'backup_root' => directoryCanBeUsed($preferredBackupRoot) ? $preferredBackupRoot : $fallbackBackupRoot,
        'release_fallback' => !directoryCanBeUsed($preferredReleaseRoot),
        'backup_fallback' => !directoryCanBeUsed($preferredBackupRoot),
    ];
}

function envValue(string $file, string $key): string
{
    $lines = @file($file, FILE_IGNORE_NEW_LINES);
    if (!is_array($lines)) {
        return '';
    }
    foreach ($lines as $line) {
        $line = rtrim($line, "\r\n");
        if (preg_match('/^\s*' . preg_quote($key, '/') . '=(.*)$/', $line, $match) === 1) {
            return trim($match[1]);
        }
    }
    return '';
}

function preflight(bool $isHttps): array
{
    $archive = CORALI_HOME . '/' . CORALI_ARCHIVE;
    $checksum = CORALI_HOME . '/' . CORALI_CHECKSUM;
    $apps = CORALI_HOME . '/apps';
    $deploymentDirectories = deploymentDirectories();
    $releases = $deploymentDirectories['release_root'];
    $backups = $deploymentDirectories['backup_root'];
    $checks = [];
    $add = static function (string $label, bool $ok, string $detail) use (&$checks): void {
        $checks[] = ['label' => $label, 'ok' => $ok, 'detail' => $detail];
    };

    $add(bilingual('Ασφαλής σύνδεση HTTPS', 'Secure HTTPS connection'), $isHttps, $isHttps ? bilingual('Ενεργή', 'Active') : bilingual('Ανοίξτε τον installer μόνο με https://', 'Open the installer only with https://'));
    $add(bilingual('PHP 8.1 ή νεότερο', 'PHP 8.1 or newer'), version_compare(PHP_VERSION, '8.1.0', '>='), 'PHP ' . PHP_VERSION);
    $execOk = availableFunction('exec');
    $add(bilingual('Εκτέλεση διεργασιών PHP', 'PHP process execution'), $execOk, $execOk ? bilingual('Η exec είναι διαθέσιμη', 'exec is available') : bilingual('Η exec είναι απενεργοποιημένη στο PHP configuration', 'exec is disabled in the PHP configuration'));

    $effectiveUser = '';
    if ($execOk) {
        $userOutput = [];
        $userStatus = 1;
        exec('id -un 2>/dev/null', $userOutput, $userStatus);
        if ($userStatus === 0) {
            $effectiveUser = trim((string) ($userOutput[0] ?? ''));
        }
    }
    $add(
        bilingual('Χρήστης εκτέλεσης cPanel', 'cPanel execution user'),
        $effectiveUser === CORALI_APP_USER,
        $effectiveUser === CORALI_APP_USER
            ? bilingual('Η PHP εκτελείται ως ', 'PHP runs as ') . CORALI_APP_USER
            : bilingual('Αναμενόταν ', 'Expected ') . CORALI_APP_USER . bilingual(', βρέθηκε ', ', found ') . ($effectiveUser !== '' ? $effectiveUser : bilingual('άγνωστος χρήστης', 'unknown user')),
    );

    foreach (['bash', 'tar', 'node', 'pg_dump', 'sha256sum', 'nohup'] as $command) {
        $path = $execOk ? resolvedCommandPath($command) : '';
        $missingDetail = $command === 'node'
            ? bilingual('Δεν βρέθηκε ούτε στο PATH ούτε στις ασφαλείς τοποθεσίες Node.js του cPanel', 'Not found in PATH or trusted cPanel Node.js locations')
            : bilingual('Δεν βρέθηκε στο PATH του PHP', 'Not found in the PHP PATH');
        $add(bilingual('Εντολή ', 'Command ') . $command, $path !== '', $path !== '' ? $path : $missingDetail);
    }

    $nodeVersion = '';
    $nodeOk = false;
    $nodePath = $execOk ? resolvedCommandPath('node') : '';
    if ($nodePath !== '') {
        $nodeOutput = [];
        $nodeStatus = 1;
        exec(escapeshellarg($nodePath) . ' --version 2>/dev/null', $nodeOutput, $nodeStatus);
        $nodeVersion = trim((string) ($nodeOutput[0] ?? ''));
        if ($nodeStatus === 0 && preg_match('/^v(\d+)/', $nodeVersion, $nodeMatch) === 1) {
            $nodeOk = (int) $nodeMatch[1] >= 22;
        }
    }
    $add(bilingual('Node.js 22 ή νεότερο', 'Node.js 22 or newer'), $nodeOk, $nodeVersion !== '' ? $nodeVersion : bilingual('Δεν ήταν δυνατό να διαβαστεί η έκδοση', 'Could not read the version'));

    $archiveOk = is_file($archive) && is_readable($archive);
    $checksumOk = is_file($checksum) && is_readable($checksum);
    $add(bilingual('Πακέτο εγκατάστασης', 'Installation package'), $archiveOk, $archiveOk ? $archive : bilingual('Λείπει: ', 'Missing: ') . $archive);
    $add(bilingual('Αρχείο SHA-256', 'SHA-256 file'), $checksumOk, $checksumOk ? $checksum : bilingual('Λείπει: ', 'Missing: ') . $checksum);

    $hashOk = false;
    $hashDetail = bilingual('Δεν ήταν δυνατό να γίνει επαλήθευση', 'Verification could not be completed');
    if ($archiveOk && $checksumOk) {
        $checksumText = trim((string) file_get_contents($checksum));
        if (preg_match('/^([a-f0-9]{64})\s+/i', $checksumText, $match) === 1) {
            $actual = hash_file('sha256', $archive);
            $hashOk = is_string($actual) && hash_equals(strtolower($match[1]), strtolower($actual));
            $hashDetail = $hashOk ? bilingual('Το checksum είναι σωστό', 'Checksum is correct') : bilingual('Το checksum δεν ταιριάζει — μην συνεχίσετε', 'Checksum mismatch — do not continue');
        }
    }
    $add(bilingual('Ακεραιότητα πακέτου', 'Package integrity'), $hashOk, $hashDetail);

    $layoutOk = false;
    if ($hashOk && $execOk && resolvedCommandPath('tar') !== '') {
        $layoutOutput = [];
        $layoutStatus = 1;
        exec('tar -tzf ' . escapeshellarg($archive) . ' ./INSTALL-CPANEL.sh ./DEPLOY_VERSION.txt >/dev/null 2>&1', $layoutOutput, $layoutStatus);
        $layoutOk = $layoutStatus === 0;
    }
    $add(bilingual('Δομή πακέτου εγκατάστασης', 'Installation package layout'), $layoutOk, $layoutOk ? bilingual('Βρέθηκαν installer και deployment version', 'Installer and deployment version found') : bilingual('Το archive δεν έχει την αναμενόμενη δομή', 'The archive does not have the expected layout'));

    $appsWritable = directoryCanBeUsed($apps);
    $add(bilingual('Εγγράψιμος φάκελος ', 'Writable directory ') . $apps, $appsWritable, $appsWritable ? 'OK' : bilingual('Δεν είναι εγγράψιμος από την PHP', 'Not writable by PHP'));
    $releaseWritable = directoryCanBeUsed($releases);
    $releaseDetail = $releaseWritable
        ? ($deploymentDirectories['release_fallback'] ? bilingual('Ασφαλής ιδιωτική εναλλακτική μέσα στο apps', 'Secure private fallback inside apps') : 'OK')
        : bilingual('Δεν είναι εγγράψιμος από την PHP', 'Not writable by PHP');
    $add(bilingual('Φάκελος προσωρινών εκδόσεων ', 'Release staging directory ') . $releases, $releaseWritable, $releaseDetail);
    $backupWritable = directoryCanBeUsed($backups);
    $backupDetail = $backupWritable
        ? ($deploymentDirectories['backup_fallback'] ? bilingual('Ασφαλής ιδιωτική εναλλακτική μέσα στο apps', 'Secure private fallback inside apps') : 'OK')
        : bilingual('Δεν είναι εγγράψιμος από την PHP', 'Not writable by PHP');
    $add(bilingual('Φάκελος αντιγράφων ασφαλείας ', 'Backup directory ') . $backups, $backupWritable, $backupDetail);

    foreach ([CORALI_PMS_ROOT => 'PMS', CORALI_BOOKING_ROOT => 'Booking'] as $root => $name) {
        $appOk = is_dir($root) && is_file($root . '/app.js');
        $envOk = is_file($root . '/runtime.env') && is_readable($root . '/runtime.env');
        $add($name . bilingual(' ενεργή εφαρμογή', ' active application'), $appOk, $appOk ? $root : bilingual('Δεν βρέθηκε app.js στον ', 'app.js was not found in ') . $root);
        $add($name . bilingual(' προστατευμένες ρυθμίσεις', ' protected settings'), $envOk, $envOk ? bilingual('Το runtime.env είναι αναγνώσιμο', 'runtime.env is readable') : bilingual('Το runtime.env λείπει ή δεν είναι αναγνώσιμο', 'runtime.env is missing or unreadable'));
    }

    $pmsKey = envValue(CORALI_PMS_ROOT . '/runtime.env', 'PMS_DOCUMENT_KEY');
    $bookingKey = envValue(CORALI_BOOKING_ROOT . '/runtime.env', 'PMS_DOCUMENT_KEY');
    $keysOk = $pmsKey !== '' && $bookingKey !== '' && hash_equals($pmsKey, $bookingKey);
    $add(bilingual('Συμφωνία PMS_DOCUMENT_KEY', 'PMS_DOCUMENT_KEY agreement'), $keysOk, $keysOk ? bilingual('Τα δύο apps έχουν το ίδιο προστατευμένο κλειδί', 'Both applications use the same protected key') : bilingual('Τα κλειδιά λείπουν ή δεν συμφωνούν', 'Keys are missing or do not match'));
    unset($pmsKey, $bookingKey);

    return $checks;
}

function allChecksPass(array $checks): bool
{
    foreach ($checks as $check) {
        if (($check['ok'] ?? false) !== true) {
            return false;
        }
    }
    return true;
}

function stateDirectory(): string
{
    return CORALI_HOME . '/.corali-web-installer-__INSTALL_STATE_ID__';
}

function stateFile(): string
{
    return stateDirectory() . '/state.json';
}

function loadState(): array
{
    $file = stateFile();
    if (!is_file($file)) {
        return [];
    }
    $decoded = json_decode((string) file_get_contents($file), true);
    return is_array($decoded) ? $decoded : [];
}

function saveState(array $state): void
{
    $directory = stateDirectory();
    if (!is_dir($directory) && !mkdir($directory, 0700, true) && !is_dir($directory)) {
        throw new RuntimeException(bilingual('Δεν ήταν δυνατό να δημιουργηθεί ο ιδιωτικός φάκελος κατάστασης.', 'Could not create the private state directory.'));
    }
    chmod($directory, 0700);
    $temporary = $directory . '/state.json.tmp';
    file_put_contents($temporary, json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), LOCK_EX);
    chmod($temporary, 0600);
    rename($temporary, stateFile());
}

function processAlive(int $pid): bool
{
    if ($pid < 1 || !availableFunction('exec')) {
        return false;
    }
    $output = [];
    $status = 1;
    exec('kill -0 ' . $pid . ' 2>/dev/null', $output, $status);
    return $status === 0;
}

function sanitizedLog(string $path): string
{
    if (!is_file($path) || !is_readable($path)) {
        return '';
    }
    $lines = file($path, FILE_IGNORE_NEW_LINES);
    if (!is_array($lines)) {
        return '';
    }
    $text = implode("\n", array_slice($lines, -220));
    $text = preg_replace('#(postgres(?:ql)?://)[^\s/@:]+:[^\s/@]+@#i', '$1***:***@', $text) ?? $text;
    $text = preg_replace('/\b(PMS_DOCUMENT_KEY|SESSION_SECRET|OPENAI_API_KEY|WHATSAPP_ACCESS_TOKEN|SMTP_PASSWORD|STRIPE_SECRET_KEY|VIVA_CLIENT_SECRET)=\S+/i', '$1=***', $text) ?? $text;
    return $text;
}

function installationStatus(array $state): array
{
    if ($state === []) {
        return ['phase' => 'ready', 'code' => null, 'log' => ''];
    }
    $statusFile = (string) ($state['status_file'] ?? '');
    $logFile = (string) ($state['log_file'] ?? '');
    if ($statusFile !== '' && is_file($statusFile)) {
        $code = (int) trim((string) file_get_contents($statusFile));
        return ['phase' => $code === 0 ? 'complete' : 'failed', 'code' => $code, 'log' => sanitizedLog($logFile)];
    }
    $pid = (int) ($state['pid'] ?? 0);
    return [
        'phase' => processAlive($pid) ? 'running' : 'failed',
        'code' => processAlive($pid) ? null : 255,
        'log' => sanitizedLog($logFile),
    ];
}

function requireCsrf(): void
{
    $provided = $_POST['csrf'] ?? '';
    $expected = $_SESSION['csrf'] ?? '';
    if (!is_string($provided) || !is_string($expected) || $expected === '' || !hash_equals($expected, $provided)) {
        failPage(403, bilingual('Μη έγκυρο αίτημα', 'Invalid request'), bilingual('Η συνεδρία έληξε ή ο κωδικός CSRF δεν είναι έγκυρος. Ανοίξτε ξανά τον installer.', 'The session expired or the CSRF token is invalid. Open the installer again.'));
    }
}

function startInstallation(array $checks): void
{
    if (!allChecksPass($checks)) {
        throw new RuntimeException(bilingual('Ο προέλεγχος δεν ολοκληρώθηκε επιτυχώς.', 'The preflight check did not pass.'));
    }
    $current = installationStatus(loadState());
    if ($current['phase'] === 'running') {
        throw new RuntimeException(bilingual('Υπάρχει ήδη εγκατάσταση σε εξέλιξη.', 'An installation is already running.'));
    }

    $stateDir = stateDirectory();
    if (!is_dir($stateDir)) {
        mkdir($stateDir, 0700, true);
    }
    chmod($stateDir, 0700);
    foreach (['install.log', 'exit.status', 'runner.sh'] as $old) {
        @unlink($stateDir . '/' . $old);
    }

    $deploymentDirectories = deploymentDirectories();
    $releaseRoot = $deploymentDirectories['release_root'];
    $backupRoot = $deploymentDirectories['backup_root'];
    if (!directoryCanBeUsed($releaseRoot) || !directoryCanBeUsed($backupRoot)) {
        throw new RuntimeException(bilingual('Οι ασφαλείς φάκελοι έκδοσης ή backup δεν είναι διαθέσιμοι. Εκτελέστε ξανά τον προέλεγχο.', 'The secure release or backup directories are unavailable. Run the preflight check again.'));
    }
    $nodePath = resolvedCommandPath('node');
    if ($nodePath === '') {
        throw new RuntimeException(bilingual('Δεν βρέθηκε συμβατό Node.js στο cPanel.', 'A compatible cPanel Node.js installation was not found.'));
    }

    $suffix = gmdate('Ymd\THis\Z') . '-' . bin2hex(random_bytes(3));
    $release = $releaseRoot . '/corali-v50-web-' . $suffix;
    $archive = CORALI_HOME . '/' . CORALI_ARCHIVE;
    $log = $stateDir . '/install.log';
    $status = $stateDir . '/exit.status';
    $runner = $stateDir . '/runner.sh';

    $command = 'bash INSTALL-CPANEL.sh --yes'
        . ' --pms-root ' . escapeshellarg(CORALI_PMS_ROOT)
        . ' --booking-root ' . escapeshellarg(CORALI_BOOKING_ROOT)
        . ' --user ' . escapeshellarg(CORALI_APP_USER)
        . ' --pms-url ' . escapeshellarg(CORALI_PMS_URL)
        . ' --booking-url ' . escapeshellarg(CORALI_BOOKING_URL)
        . ' --backup-dir ' . escapeshellarg($backupRoot);

    $runtimePath = implode(':', array_unique([
        dirname($nodePath),
        '/usr/local/bin',
        '/usr/bin',
        '/bin',
        '/opt/cpanel/ea-nodejs26/bin',
        '/opt/cpanel/ea-nodejs24/bin',
        '/opt/cpanel/ea-nodejs22/bin',
    ]));

    $script = implode("\n", [
        '#!/usr/bin/env bash',
        'set -uo pipefail',
        'export PATH=' . escapeshellarg($runtimePath),
        'umask 077',
        'rc=0',
        'echo "Hotel Corali web installer — ' . CORALI_INSTALLER_RELEASE . '"',
        'echo "[web] Verifying archive checksum..."',
        'cd ' . escapeshellarg(CORALI_HOME) . ' || rc=$?',
        'if [[ "$rc" -eq 0 ]]; then sha256sum -c ' . escapeshellarg(CORALI_CHECKSUM) . ' || rc=$?; fi',
        'if [[ "$rc" -eq 0 ]]; then mkdir -p ' . escapeshellarg($release) . ' || rc=$?; fi',
        'if [[ "$rc" -eq 0 ]]; then echo "[web] Extracting verified release..."; tar -xzf ' . escapeshellarg($archive) . ' -C ' . escapeshellarg($release) . ' || rc=$?; fi',
        'if [[ "$rc" -eq 0 ]]; then cd ' . escapeshellarg($release) . ' || rc=$?; fi',
        'if [[ "$rc" -eq 0 ]]; then ' . $command . ' || rc=$?; fi',
        'status_tmp=' . escapeshellarg($status . '.tmp') . '.$$',
        'printf "%s\n" "$rc" > "$status_tmp"',
        'mv "$status_tmp" ' . escapeshellarg($status),
        'exit "$rc"',
        '',
    ]);
    if (file_put_contents($runner, $script, LOCK_EX) === false) {
        throw new RuntimeException(bilingual('Δεν ήταν δυνατό να δημιουργηθεί ο ασφαλής runner.', 'Could not create the secure installer runner.'));
    }
    chmod($runner, 0700);
    touch($log);
    chmod($log, 0600);

    $launch = 'nohup bash ' . escapeshellarg($runner) . ' >' . escapeshellarg($log) . ' 2>&1 < /dev/null & echo $!';
    $output = [];
    $launchStatus = 1;
    exec($launch, $output, $launchStatus);
    $pid = (int) trim((string) ($output[0] ?? '0'));
    if ($launchStatus !== 0 || $pid < 1) {
        throw new RuntimeException(bilingual('Δεν ήταν δυνατό να ξεκινήσει η διεργασία εγκατάστασης.', 'Could not start the installation process.'));
    }
    saveState([
        'pid' => $pid,
        'started_at' => gmdate(DATE_ATOM),
        'release_dir' => $release,
        'log_file' => $log,
        'status_file' => $status,
    ]);
}

function recoverAdministrator(array $input): void
{
    $status = installationStatus(loadState());
    if ($status['phase'] !== 'complete') {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'The installation must complete before administrator recovery.' : 'Η εγκατάσταση πρέπει να ολοκληρωθεί πριν από την ανάκτηση διαχειριστή.');
    }

    $username = strtolower(trim((string) ($input['admin_username'] ?? '')));
    $displayName = trim((string) ($input['admin_display_name'] ?? ''));
    $email = strtolower(trim((string) ($input['admin_email'] ?? '')));
    $password = (string) ($input['admin_password'] ?? '');
    $confirmation = (string) ($input['admin_password_confirmation'] ?? '');
    if (!preg_match('/^[a-z0-9._-]{3,100}$/', $username)) {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'Use 3–100 lowercase letters, numbers, dots, underscores or hyphens for the username.' : 'Το όνομα χρήστη πρέπει να έχει 3–100 πεζούς λατινικούς χαρακτήρες, αριθμούς, τελείες, κάτω παύλες ή παύλες.');
    }
    if (strlen($displayName) < 2 || strlen($displayName) > 300) {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'Enter a valid full name.' : 'Συμπληρώστε έγκυρο ονοματεπώνυμο.');
    }
    if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'Enter a valid email address.' : 'Συμπληρώστε έγκυρη διεύθυνση email.');
    }
    if (strlen($password) < 14 || strlen($password) > 256) {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'The password must contain 14 to 256 characters.' : 'Ο κωδικός πρέπει να περιέχει 14 έως 256 χαρακτήρες.');
    }
    if (!hash_equals($password, $confirmation)) {
        throw new RuntimeException(i18n('password_mismatch'));
    }

    $nodePath = resolvedCommandPath('node');
    $script = CORALI_PMS_ROOT . '/scripts/recover-admin.mjs';
    $runtime = CORALI_PMS_ROOT . '/runtime.env';
    if ($nodePath === '' || !is_file($script) || !is_file($runtime)) {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'The administrator recovery tool is not available.' : 'Το εργαλείο ανάκτησης διαχειριστή δεν είναι διαθέσιμο.');
    }

    $inputFile = stateDirectory() . '/admin-recovery-' . bin2hex(random_bytes(8)) . '.json';
    $payload = json_encode([
        'username' => $username,
        'displayName' => $displayName,
        'email' => $email,
        'password' => $password,
        'resetTwoFactor' => true,
    ], JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
    if (file_put_contents($inputFile, $payload, LOCK_EX) === false) {
        throw new RuntimeException($GLOBALS['language'] === 'en' ? 'Could not create the protected recovery request.' : 'Δεν ήταν δυνατό να δημιουργηθεί το προστατευμένο αίτημα ανάκτησης.');
    }
    chmod($inputFile, 0600);
    try {
        $output = [];
        $exitCode = 1;
        $command = escapeshellarg($nodePath)
            . ' --env-file=' . escapeshellarg($runtime)
            . ' ' . escapeshellarg($script)
            . ' ' . escapeshellarg($inputFile) . ' 2>&1';
        exec($command, $output, $exitCode);
        if ($exitCode !== 0) {
            error_log('Corali administrator recovery failed: ' . implode("\n", $output));
            throw new RuntimeException($GLOBALS['language'] === 'en' ? 'Administrator recovery failed. No password was displayed or retained.' : 'Η ανάκτηση διαχειριστή απέτυχε. Κανένας κωδικός δεν εμφανίστηκε ή διατηρήθηκε.');
        }
    } finally {
        @unlink($inputFile);
        unset($password, $confirmation, $payload);
    }
}

if (is_file(stateDirectory() . '/locked')) {
    failPage(410, bilingual('Ο installer είναι κλειδωμένος', 'Installer locked'), bilingual('Η εγκατάσταση έχει ήδη οριστικοποιηθεί. Διαγράψτε το προσωρινό PHP αρχείο αν εξακολουθεί να υπάρχει.', 'Installation has already been finalized. Delete the temporary PHP file if it still exists.'));
}

if (!$isHttps) {
    failPage(400, bilingual('Απαιτείται HTTPS', 'HTTPS required'), bilingual('Ανοίξτε την ίδια διεύθυνση με https:// για ασφαλή εγκατάσταση.', 'Open the same address with https:// for a secure installation.'));
}

function authorizeAccessKey(string $accessKey): bool
{
    if ($accessKey === '' || !hash_equals(CORALI_INSTALL_TOKEN_HASH, hash('sha256', $accessKey))) {
        return false;
    }
    session_regenerate_id(true);
    $_SESSION['corali_authorized'] = true;
    $_SESSION['csrf'] = bin2hex(random_bytes(32));
    unset($_SESSION['access_csrf']);
    return true;
}

$accessKey = $_GET['key'] ?? '';
if (empty($_SESSION['corali_authorized']) && is_string($accessKey) && $accessKey !== '') {
    if (authorizeAccessKey($accessKey)) {
        $cleanUrl = strtok($_SERVER['REQUEST_URI'] ?? '', '?') ?: ($_SERVER['PHP_SELF'] ?? '/');
        header('Location: ' . $cleanUrl, true, 303);
        exit;
    }
}

if (empty($_SESSION['corali_authorized'])) {
    $accessCsrf = (string) ($_SESSION['access_csrf'] ?? '');
    if ($accessCsrf === '') {
        $accessCsrf = bin2hex(random_bytes(32));
        $_SESSION['access_csrf'] = $accessCsrf;
    }
    if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST' && ($_POST['access_action'] ?? '') === 'authorize') {
        $providedCsrf = $_POST['access_csrf'] ?? '';
        $providedKey = $_POST['access_key'] ?? '';
        $csrfOk = is_string($providedCsrf) && hash_equals($accessCsrf, $providedCsrf);
        if ($csrfOk && is_string($providedKey) && authorizeAccessKey(trim($providedKey))) {
            $cleanUrl = strtok($_SERVER['REQUEST_URI'] ?? '', '?') ?: ($_SERVER['PHP_SELF'] ?? '/');
            header('Location: ' . $cleanUrl, true, 303);
            exit;
        }
        accessPage($accessCsrf, i18n('invalid_access'));
    }
    accessPage($accessCsrf);
}

$csrf = (string) ($_SESSION['csrf'] ?? '');
if ($csrf === '') {
    $csrf = bin2hex(random_bytes(32));
    $_SESSION['csrf'] = $csrf;
}

$action = $_GET['action'] ?? '';
if ($action === 'status') {
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode(installationStatus(loadState()), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    exit;
}

$message = '';
$error = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    requireCsrf();
    $postAction = $_POST['action'] ?? '';
    try {
        if ($postAction === 'start') {
            startInstallation(preflight($isHttps));
            header('Location: ' . ($_SERVER['PHP_SELF'] ?? '/'), true, 303);
            exit;
        }
        if ($postAction === 'recover_admin') {
            recoverAdministrator($_POST);
            $savedState = loadState();
            $savedState['admin_recovered_at'] = gmdate(DATE_ATOM);
            saveState($savedState);
            $message = i18n('admin_recovered');
        }
        if ($postAction === 'finish') {
            $status = installationStatus(loadState());
            if ($status['phase'] !== 'complete') {
                throw new RuntimeException(bilingual('Η εγκατάσταση δεν έχει ολοκληρωθεί επιτυχώς.', 'The installation has not completed successfully.'));
            }
            if (empty(loadState()['admin_recovered_at'])) {
                throw new RuntimeException($language === 'en' ? 'Save and test the PMS administrator account before deleting the installer.' : 'Αποθηκεύστε και δοκιμάστε τον λογαριασμό διαχειριστή PMS πριν διαγράψετε τον installer.');
            }
            file_put_contents(stateDirectory() . '/locked', gmdate(DATE_ATOM), LOCK_EX);
            chmod(stateDirectory() . '/locked', 0600);
            $deleted = @unlink(__FILE__);
            $_SESSION = [];
            session_destroy();
            $message = $deleted
                ? bilingual('Η εγκατάσταση ολοκληρώθηκε και ο web installer διαγράφηκε.', 'Installation completed and the web installer was deleted.')
                : bilingual('Η εγκατάσταση ολοκληρώθηκε. Διαγράψτε τώρα χειροκίνητα αυτό το PHP αρχείο από το public_html.', 'Installation completed. Delete this PHP file manually from public_html now.');
        }
    } catch (Throwable $exception) {
        $error = $exception->getMessage();
    }
}

$checks = preflight($isHttps);
$ready = allChecksPass($checks);
$state = loadState();
$installStatus = installationStatus($state);
$adminRecovered = !empty($state['admin_recovered_at']);
$safeCsrf = htmlspecialchars($csrf, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
?>
