        <div class="field"><label for="admin_username"><?= htmlspecialchars(i18n('username'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></label><input id="admin_username" name="admin_username" pattern="[a-z0-9._-]{3,100}" autocomplete="username" required></div>
        <div class="field"><label for="admin_display_name"><?= htmlspecialchars(i18n('display_name'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></label><input id="admin_display_name" name="admin_display_name" maxlength="150" autocomplete="name" required></div>
        <div class="field full"><label for="admin_email"><?= htmlspecialchars(i18n('email'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></label><input id="admin_email" name="admin_email" type="email" maxlength="254" autocomplete="email" required></div>
        <div class="field"><label for="admin_password"><?= htmlspecialchars(i18n('password'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></label><input id="admin_password" name="admin_password" type="password" minlength="14" maxlength="256" autocomplete="new-password" required></div>
        <div class="field"><label for="admin_password_confirmation"><?= htmlspecialchars(i18n('confirm_password'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></label><input id="admin_password_confirmation" name="admin_password_confirmation" type="password" minlength="14" maxlength="256" autocomplete="new-password" required></div>
      </div>
      <label class="choice"><input type="checkbox" checked disabled><span><?= htmlspecialchars(i18n('reset_2fa'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></span></label>
      <div class="actions"><button class="btn" type="submit"><?= htmlspecialchars(i18n('recover_admin'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></button></div>
