  <section id="finishCard" class="card" <?= $installStatus['phase'] === 'complete' ? '' : 'hidden' ?>>
    <div class="step"><div class="num">4</div><div><h2><?= htmlspecialchars(i18n('final_check'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></h2><p><?= htmlspecialchars(i18n('final_help'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></p></div></div>
    <div class="links"><a href="<?= CORALI_PMS_URL ?>/login" target="_blank" rel="noopener"><?= htmlspecialchars(i18n('check_pms'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></a><a href="<?= CORALI_BOOKING_URL ?>/book" target="_blank" rel="noopener"><?= htmlspecialchars(i18n('check_booking'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></a></div>
    <form method="post" class="actions"><input type="hidden" name="csrf" value="<?= $safeCsrf ?>"><input type="hidden" name="language" value="<?= htmlspecialchars($language, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>"><input type="hidden" name="action" value="finish"><button class="btn secondary" type="submit" <?= $adminRecovered ? '' : 'disabled' ?>><?= htmlspecialchars(i18n('delete_installer'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></button></form>
  </section>
  <p class="foot"><?= htmlspecialchars(i18n('secrets_hidden'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></p>
</main>
<script>
(() => {
  const initial = <?= json_encode($installStatus['phase']) ?>;
  const panel = document.getElementById('progressPanel');
  const bar = document.getElementById('bar');
  const phase = document.getElementById('phase');
  const log = document.getElementById('log');
  const finish = document.getElementById('finishCard');
  const admin = document.getElementById('adminCard');
  const labels = {ready:<?= json_encode(i18n('ready'), JSON_UNESCAPED_UNICODE) ?>,running:<?= json_encode(i18n('running'), JSON_UNESCAPED_UNICODE) ?>,complete:<?= json_encode(i18n('complete'), JSON_UNESCAPED_UNICODE) ?>,failed:<?= json_encode(i18n('failed'), JSON_UNESCAPED_UNICODE) ?>};
  function render(data) {
    panel.hidden = false;
    phase.textContent = labels[data.phase] || data.phase;
    log.textContent = data.log || '';
    log.scrollTop = log.scrollHeight;
    let percent = data.phase === 'complete' ? 100 : (data.phase === 'failed' ? 100 : 8);
    const matches = [...(data.log || '').matchAll(/\[(\d)\/9\]/g)];
    if (matches.length && data.phase === 'running') percent = Math.max(percent, Number(matches[matches.length - 1][1]) / 9 * 100);
    bar.style.width = percent + '%';
    if (data.phase === 'failed') bar.style.background = '#ad3527';
    finish.hidden = data.phase !== 'complete';
    admin.hidden = data.phase !== 'complete';
  }
  async function poll() {
    try {
      const response = await fetch('?action=status', {cache:'no-store', credentials:'same-origin'});
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      render(data);
      if (data.phase === 'running') setTimeout(poll, 1400);
      else if (initial === 'running') setTimeout(() => location.reload(), 1200);
    } catch (error) {
      phase.textContent = <?= json_encode(bilingual('Προσωρινό σφάλμα ενημέρωσης: ', 'Temporary status update error: '), JSON_UNESCAPED_UNICODE) ?> + error.message;
      setTimeout(poll, 3000);
    }
  }
  if (initial === 'running') poll(); else if (initial !== 'ready') render(<?= json_encode($installStatus, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);
})();
</script>
</body>
</html>
